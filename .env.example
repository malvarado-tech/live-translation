# Environment variables for live-translation.
# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Secrets (no NEXT_PUBLIC_ prefix) are read only by server routes and never
# reach the browser. NEXT_PUBLIC_ values are inlined into the client bundle
# at build time, so they must never hold a secret.

# ---------------------------------------------------------------------------
# Required: OpenAI realtime translation
# ---------------------------------------------------------------------------
# Server-side key used by /api/session to mint a short-lived client secret for
# the operator's browser. Needs access to the gpt-realtime-translate model.
OPENAI_API_KEY=

# Optional value sent as the OpenAI-Safety-Identifier header. Use a stable,
# non-personal identifier for this deployment. Defaults to "live-translation-anon".
OPENAI_SAFETY_IDENTIFIER=

# ---------------------------------------------------------------------------
# Required for fan-out to listeners' phones: LiveKit
# ---------------------------------------------------------------------------
# Server-side credentials used by /api/publish-token and /api/listen-token to
# sign room-scoped JWTs. A LiveKit server started with --dev uses
# devkey / secret; never expose a --dev server to the internet.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public WebSocket URL of your LiveKit server, for example ws://192.168.1.50:7880
# on a LAN. Leave empty to run the operator dashboard without fan-out.
NEXT_PUBLIC_LIVEKIT_URL=

# Base URL the listener QR code and link are built from, for example
# http://192.168.1.50:3000. Must be reachable from phones (not localhost).
# Falls back to the browser's origin if empty; also editable in the UI.
NEXT_PUBLIC_LISTENER_BASE_URL=

# ---------------------------------------------------------------------------
# Optional: Gemini Live (experimental, hidden in the UI)
# ---------------------------------------------------------------------------
# Server-side key used by /api/gemini-token to mint an ephemeral token.
# Only needed if you re-enable the Gemini comparison engine.
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: local development on a LAN
# ---------------------------------------------------------------------------
# Comma-separated hosts allowed to load dev assets (next.config.ts), for
# example 192.168.1.50. Without it, phones on the LAN see a dead listener page
# under `npm run dev`.
ALLOWED_DEV_ORIGINS=
